# Стенд: doitai (боевая копия doitai.ru, сплит). Несекретный конфиг — в git.
APPS_ROOT=/var/www
ROOT_DOMAIN=doitai.ru
FRONT_DOMAIN=app.doitai.ru
API_DOMAIN=api.doitai.ru
ADMIN_DOMAIN=admin.doitai.ru
CERT_NAME=doitai.ru

# Внешний контур раннеров полигона MCP — прод-аналог mcp.test.doitai.ru
# (тот в testzone-слое). Домен попадает в SAN условным -d в Makefile;
# при первом добавлении на живом стенде нужен make certs-expand.
MCP_DOMAIN=mcp.doitai.ru

# Внешний ASR-бокс в LAN (голосовая диктовка). Не задать = инертный дефолт
# 127.0.0.1:9 и молча мёртвая диктовка.
ASR_WS_UPSTREAM=192.168.100.29:49153

# Ниже — значения, сверенные с боем 2026-07-30 (живой .env + docker inspect).
# Заданы явно, а не оставлены на дефолты compose: прод не должен уезжать вслед
# за правкой дефолта в docker-compose.yml.
ECOSYSTEM_SUBNET=172.30.0.0/24
ECOSYSTEM_GATEWAY=172.30.0.1
# Живой storage на v1.17.0 — дефолт compose (v1.12.4) НЕЛЬЗЯ: даунгрейд storage
# не поднимется.
QDRANT_VERSION=v1.17.0
# doitai 16G RAM → буфер 4G (совпадает с живым innodb_buffer_pool_size).
MARIADB_BUFFER_POOL=4G
# Живой redis запущен с --maxmemory 2gb; дефолт 512mb сузил бы лимит вчетверо
# (политика volatile-lru: ключи без TTL — очереди — не вытесняются, запись
# начала бы отдавать OOM).
REDIS_MAXMEMORY=2gb
# Живой образ neo4j — этот тег; heap/pagecache на дефолтах (по 512m).
NEO4J_VERSION=5.26.28-community

# Корень отдаёт лендинг (репозиторий ai-box-site). Парная переменная
# ROOT_REDIRECT_DOMAIN намеренно НЕ задана — её vhost остаётся на инертном
# дефолте root-redirect.invalid.
LANDING_DOMAIN=doitai.ru

# Поддомен people — карточка «AI-трансформация» (ai-box-site, папка people/).
PEOPLE_DOMAIN=people.doitai.ru
