# ШАБЛОН overlay-слоя тест-зоны (committed). Копировать в env/<stend>/testzone.env
# ТОЛЬКО на стенде, где тест-зона реально включена (симлинк
# docker-compose.override.yml → docker-compose.testzone.yml, см. make testzone-enable).
#
# Наличие файла = признак активной тест-зоны: Makefile подключает слой и его
# переменные попадают и в интерполяцию compose (все обязательные, `:?`), и в
# DOMAINS сертификата. Поэтому на стенде без тест-зоны файл создавать НЕЛЬЗЯ:
# certs-init запросил бы серт на несуществующие домены.
TEST_FRONT_DOMAIN=app.test.example.ru
TEST_API_DOMAIN=api.test.example.ru
TEST_ADMIN_DOMAIN=admin.test.example.ru

# Внешний контур ai-box-mcp для раннеров полигона: наружу светит строго
# /api/external/runner/*, control plane /api/v1 недостижим (шаблон
# nginx/templates-test/mcp.conf.template, разбор — .claude/wiki/entities/nginx-edge.md).
TEST_MCP_DOMAIN=mcp.test.example.ru
