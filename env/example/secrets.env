# ШАБЛОН секретов стенда. Реальный env/<stend>/secrets.env НЕ коммитится
# (gitignored), лежит на сервере, chmod 600. Генерить: openssl rand -hex 24.
# Без символов # и $ в значениях (ломают make -include).
DB_ROOT_PASSWORD=
AI_BOX_DB_PASSWORD=
AI_BOX_DR_DB_PASSWORD=
AI_BOX_MCP_DB_PASSWORD=
REDIS_PASSWORD=
BROWSERLESS_TOKEN=
# Neo4j — точка стыковки с реестром: ai-box-data-registry в СВОЁМ .env ставит
# NEO4J_BOLT_URL=bolt://neo4j:7687, NEO4J_USER=neo4j и ТО ЖЕ значение пароля.
NEO4J_PASSWORD=

# SMTP контактной формы лендинга (doitai.ru → sales@doitai.ru).
# Хост/логин/пароль выдаются отдельно; пусто = форма отвечает 503.
LANDING_SMTP_HOST=
LANDING_SMTP_USER=
LANDING_SMTP_PASS=

# Серверный ключ Яндекс SmartCaptcha (валидация токена контактной формы;
# пусто = проверка капчи выключена).
LANDING_SMARTCAPTCHA_SERVER_KEY=
