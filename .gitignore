# Плоский .env выпилен (env-per-stend, decisions/env-per-stend.md).
# Секреты стендов — env/*/secrets.env (на серверах, не в git). Транзитивно
# .env всё ещё игнорируем (мог остаться на старых серверах).
.env
env/*/secrets.env
!env/example/secrets.env

# Маркер стенда: имя стенда одной строкой, своё на каждом хосте (Makefile: STAND).
.stand

# Рендер nginx-шаблонов (envsubst из nginx/templates/ при старте контейнера)
nginx/conf.d/root.conf
nginx/conf.d/front.conf
nginx/conf.d/api.conf
nginx/conf.d/admin.conf

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Тест-шаблоны, доставленные testzone-enable
nginx/templates/test-*.conf.template

# Плагин Neo4j GDS — ставится make neo4j-plugins (пин+sha256), не коммитим
neo4j/plugins/*.jar
